# ---------------------------------------------------------------------------
# Cold Chain Monitor - environment configuration
# Copy this file to `.env.local` and adjust the values for your environment.
# ---------------------------------------------------------------------------

# Base URL of the backend REST API (used by src/services/apiClient.ts)
VITE_API_BASE_URL=http://localhost:4000/api

# Use the backend's JSON-backed simulation API. Set true only for offline UI work.
VITE_USE_MOCK_API=false

# Artificial latency (ms) applied to mock responses so loading states remain
# visible and realistic during frontend development.
VITE_MOCK_LATENCY_MS=450

# Polling interval (ms) used by the Live Monitoring telemetry stream.
VITE_TELEMETRY_POLL_INTERVAL_MS=5000

# Optional: bearer token used during local development.
VITE_API_TOKEN=
